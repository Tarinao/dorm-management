# Copy this file to .env and fill in the values from
# Supabase dashboard -> Project Settings -> API (Project URL, publishable/anon key).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Only for the one-time import script (scripts/import-old-data.ts). Do NOT prefix with VITE_.
# Better: set it in your terminal for that one command instead of saving it here.
# SUPABASE_SERVICE_ROLE_KEY=
