{
  "name": "ledger-dorm-manager",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.functions.json",
    "test:billing": "node scripts/test-billing.ts",
    "test:guide": "node scripts/test-guide.ts",
    "import:old": "node --env-file-if-exists=.env scripts/import-old-data.ts",
    "test:line": "node scripts/test-line.ts",
    "test:promptpay": "node scripts/test-promptpay.ts",
    "test:bot": "node scripts/test-bot.ts",
    "test:reservations": "node scripts/test-reservations.ts",
    "test:notify": "node scripts/test-notify.ts",
    "test:invoice": "node scripts/test-invoice.ts",
    "test": "npm run test:billing && npm run test:guide && npm run test:line && npm run test:promptpay && npm run test:bot && npm run test:reservations && npm run test:notify && npm run test:invoice",
    "richmenu:png": "node scripts/line-rich-menu.ts",
    "richmenu:create": "node scripts/line-rich-menu.ts --create"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.8",
    "vite": "^7.3.8",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
